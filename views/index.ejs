<!DOCTYPE html>
<html>

<head>
  <link rel='stylesheet' href='/stylesheets/style.css' />
</head>

<body>

  <!-- Cabecera: marca del ranking y navegación principal -->
  <header class="header">
    <h1>Arcade Ledger</h1>
    <nav class="menu">
      <ul>
        <li><a href="#rankings">Rankings</a></li>
        <li><a href="#releases">New Releases</a></li>
        <li><a href="#studios">Studios</a></li>
      </ul>
    </nav>
  </header>

  <!-- Ranking semanal: lanzamientos destacados de noviembre de 2026 -->
  <section class="ranking">
    <h2>November 2026 Standouts</h2>
    <p>Three releases already out this month, ranked from critic reviews and player scores.</p>
    <div class="ranking-inner">
      <a href="/game">
        <div class="ranking-inner-game">
          <img src="https://picsum.photos/seed/zelda-oot-2026/480/270"
            alt="Cover art for The Legend of Zelda: Ocarina of Time Remake">
          <h5>The Legend of Zelda: Ocarina of Time Remake</h5>
        </div>
      </a>
      <a href="/game">
        <div class="ranking-inner-game">
          <img src="https://picsum.photos/seed/wow-forever-2026/480/270" alt="Cover art for World of Warcraft: Forever">
          <h5>World of Warcraft: Forever</h5>
        </div>
      </a>
      <a href="/game">
        <div class="ranking-inner-game">
          <img src="https://picsum.photos/seed/godzilla-melee-2026/480/270"
            alt="Cover art for Godzilla: Destroy All Monsters Melee Remastered">
          <h5>Godzilla: Destroy All Monsters Melee Remastered</h5>
        </div>
      </a>
    </div>
  </section>

  <!-- Pie: créditos y nota de actualización del ranking -->
  <footer class="pie">
    <p>Arcade Ledger · Player and critic scores, updated every Monday.</p>
  </footer>

  <script src="/javascripts/app.js"></script>
</body>

</html>